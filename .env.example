# Copy this file to .env and fill in your values.
# Expo bakes EXPO_PUBLIC_* vars into the bundle at build time —
# restart `npx expo start --clear` after changing.

# Local dev (Express API on the same machine)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Local dev on a physical device — use your machine's LAN IP, not localhost
EXPO_PUBLIC_API_URL=http://192.168.1.64:4000

# Production
# EXPO_PUBLIC_API_URL=https://tk2do.onrender.com
